# =============================================================================
# EuroJobsCenter Germany Handbook AI Assistant — Configuration Template
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# Server Network Configuration
HOST=127.0.0.1
PORT=7860
FLASK_ENV=production

# Compute Hardware Device Override: 'cuda', 'cpu', or 'mps' (auto-detected if blank)
DEVICE=

# Local Model Weight Cache Directory
MODEL_CACHE=models

# Local Embedded Qdrant Vector Storage Directory
QDRANT_PATH=qdrant_data

# Optional Hugging Face Token (increases rate limit for downloading model weights)
# HF_TOKEN=your_huggingface_token_here

